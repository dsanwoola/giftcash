rules_version = '2';

// Gift Cash — Firestore security rules.
// Fintech posture: wallets & ledger are read-only to clients (written only by
// trusted server / Cloud Functions via the Admin SDK). Public gifting pages use
// explicit server-side projections; raw financial records are never public.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
        && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'admin';
    }

    // Profiles: a user reads/writes only their own; admins read all.
    // Users may create only a normal starter profile for themselves. Privileged
    // role/KYC changes are server-authoritative through Admin SDK API routes.
    match /profiles/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.role == 'user'
        && request.resource.data.kycStatus == 'none'
        && request.resource.data.id == uid;
      allow update: if isOwner(uid)
        && !( 'role' in request.resource.data.diff(resource.data).affectedKeys() )
        && !( 'kycStatus' in request.resource.data.diff(resource.data).affectedKeys() ); // KYC changes go through API/admin approvals
      allow delete: if false;
    }

    // Wallets & ledger: read-only to the owner; never client-writable.
    match /wallets/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
    }
    match /ledger_entries/{id} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false; // append-only, server side only
    }

    // Raw gifts contain recipient contact, reveal and provider data. Public reveal
    // pages consume /api/gifts/[slug], which returns an explicit safe projection.
    match /gifts/{slug} {
      allow get: if isSignedIn() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.claimedByUserId == request.auth.uid
      );
      allow list: if isSignedIn() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.claimedByUserId == request.auth.uid
      );
      // All gift creation and mutation is performed by authenticated API routes
      // with Admin SDK after provider verification.
      allow write: if false;
    }

    // Withdrawals: owner/admin reads; all writes are server-side so payout state,
    // ledger reservations, and reversals stay atomic.
    match /withdrawals/{id} {
      allow read: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow write: if false;
    }

    // Group gift documents contain organizer ids and payment metadata. Public
    // pages consume a sanitized server projection instead of raw documents.
    match /groupGifts/{slug} {
      allow read: if isOwner(resource.data.organizerId);
      allow create, update, delete: if false;
    }

    // Gift Party documents contain organizer setup, contributor and settlement
    // data. Only the owning organizer may read them directly. Public visitors
    // consume the explicit safe projection returned by /api/events/[slug].
    match /events/{slug} {
      allow read: if isOwner(resource.data.organizerId);
      // Event creation and every mutation use owner-verified server APIs.
      allow create, update, delete: if false;
    }

    // Moments Album metadata and moderation are server-authoritative. Public
    // clients consume a sanitized API that returns approved photos only.
    match /event_albums/{eventId} { allow read, write: if false; }
    match /event_album_photos/{photoId} { allow read, write: if false; }
    match /album_photo_reports/{reportId} { allow read, write: if false; }

    // Gift Registry records include private retailer links, organizer notes,
    // reservation state and verified payment history. Every role consumes an
    // explicit server-side projection; no client may read or mutate raw records.
    match /event_registries/{registryId} { allow read, write: if false; }
    match /event_registry_items/{itemId} { allow read, write: if false; }
    match /registry_contributions/{contributionId} { allow read, write: if false; }
    match /registry_reservations/{reservationId} { allow read, write: if false; }
    match /registry_checkout_limits/{limitId} { allow read, write: if false; }

    // Payment authority remains server-only, including uniqueness receipts.
    match /payment_intents/{id} { allow read, write: if false; }
    match /provider_transactions/{id} { allow read, write: if false; }

    // Bank-alert bridge collections: server-created, admin-readable only.
    match /bank_alerts/{id} { allow read, write: if isAdmin(); }
    match /payment_reconciliation_logs/{id} { allow read, write: if isAdmin(); }

    // Admin-only collections.
    match /admin_audit_logs/{id} { allow read, write: if isAdmin(); }
    match /fraud_flags/{id} { allow read, write: if isAdmin(); }
  }
}
